# Pharmacy Intelligence Platform — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Database files — track schema, not the data
capstone/database/*.db
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs
*.log
logs/*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Secrets / API keys
.env
*.pem
*.key

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Additional database and archive exclusions
*.db
*.sqlite
*.sqlite3
*.zip
data/zip sources/

